ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]
# Local dev DB (npm run db:start). Prod uses the Neon URL set in Vercel.
DATABASE_URL=postgresql+psycopg://pfm:pfm@localhost:5434/pfm_dev
# Signs session tokens. Any long random string; changing it signs everyone out.
# Leave empty in local dev to skip login (acts as the first user); required in production.
TOKEN_SECRET=
# The web OAuth client ID from Google Cloud. Login is closed without it and TOKEN_SECRET.
GOOGLE_CLIENT_ID=
