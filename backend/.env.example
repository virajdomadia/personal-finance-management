ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]
# Local dev DB (npm run db:start). Prod uses the Neon URL set in Vercel.
DATABASE_URL=postgresql+psycopg://pfm:pfm@localhost:5434/pfm_dev
# Must match the frontend's API_SECRET. Optional locally, required in production.
API_SECRET=
# Phone app login, which stays closed until both are set. Only needed in production.
# Same value as the frontend's APP_PASSWORD_HASH (npm --prefix frontend run --silent hash-password).
APP_PASSWORD_HASH=
# Signs phone app tokens. Any long random string; changing it logs the phone out.
TOKEN_SECRET=
