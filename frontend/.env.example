# Where Next.js proxies /api/* requests (FastAPI backend)
API_URL=http://127.0.0.1:8000

# Login. All optional locally: without TOKEN_SECRET, dev runs with no login.
# Required in production, where anything missing keeps the app locked.
# Verifies the session cookie, which holds a token issued by the API. Must match the API's TOKEN_SECRET.
TOKEN_SECRET=
# Google OAuth web client ID (public). Without it the login page says sign-in is unavailable.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
