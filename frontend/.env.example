# Where Next.js proxies /api/* requests (FastAPI backend)
API_URL=http://127.0.0.1:8000

# Login. All optional locally: without SESSION_SECRET, dev runs with no login.
# Required in production, where anything missing keeps the app locked.
# Sent to the API on every proxied request; must match the backend's API_SECRET.
API_SECRET=
# Signs the session cookie. Changing it logs out every session.
SESSION_SECRET=
# From: npm run --silent hash-password < file-containing-password
APP_PASSWORD_HASH=
